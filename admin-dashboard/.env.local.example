# Copy this file to `.env.local` and fill in your Supabase project's values.
# Same project as the Flutter app — Supabase Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — bypasses Row Level Security. Server-side only, never exposed to
# the browser (no NEXT_PUBLIC_ prefix). This is what lets the dashboard
# change roles, ban users, and moderate content without needing separate
# admin-side RLS policies. Never commit this file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
